# The app's secrets. All optional: with none set, it runs in sample mode.
#
# On your computer: copy this file to .env.local (git ignores it), fill in the
# values, and restart `npm run dev`.
# On Vercel: Project → Settings → Environment Variables. Add each one for
# Production and Preview, tick "Sensitive", then redeploy.
# GitHub needs none of these. Never commit a real value.

# Writes drafts and powers the AI Agent. Create one at
# https://openrouter.ai/settings/keys and give it a credit limit.
OPENROUTER_API_KEY=

# Not used yet (video generation is coming).
HIGGSFIELD_API_KEY=

# Not used yet (the library is in sample mode until Postgres lands).
DATABASE_URL=
